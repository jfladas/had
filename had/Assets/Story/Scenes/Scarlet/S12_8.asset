  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S12_8
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: Back in the present I hear the duke exclaim in confusion.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: What just happened?
    alternativeText: 
    character: {fileID: 11400000, guid: 3d2c1b0a9f8e7d6c5b4a392817161514, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Ray and the others are already getting the guards and the duke under control.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Careful guys, he's Scarlet's father so he's one of you.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Got it!
    alternativeText: 
    character: {fileID: 11400000, guid: f5a7c9d1e2b34567890123456789abcd, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I see them dragging him and his guards into one of the many rooms.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Seems like they're prepared foe everything. They even have a room to use as a prison.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I shift back in a hurry but I feel my body getting a little tired.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 0a531472eb715104e8acc946d055c0dd, type: 3}
  nextScene: {fileID: 11400000, guid: d0d2a2b3c4d5e6f708192a3b4c5d6e7d, type: 2}

