  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S9_X2_2a
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: Thank you, it all looks so delicious.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Wow, that egg dish looks scrumptious. Oh, or that one with the fluffy-looking
      bread. Or should I try that soup with the vibrant colour? Agh, there are too
      many choices!
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Scarlet notices my eyes darting around, inspecting every dish carefully,
      unable to decide where to start.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
      spriteIndex: 9
      type: 0
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Just try a bit of everything. Our cook is really good, so I'm sure you'll
      like it.
    alternativeText: 
    character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Ah, then I will do that.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I begin to load my plate and don't even notice Scarlet chuckling.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 137d148fee6c9644e82521638931c070, type: 3}
  nextScene: {fileID: 11400000, guid: a1b2c3d4e5f60718293a4b5c6d7e8f90, type: 2}
