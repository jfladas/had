  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S12_5
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: When I open my eyes, we're in the gang's headquarters. I see Lu, Seth and
      Ray with shocked faces.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Good, it worked!
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Guys! I need you to deal with these for me. I'm really sorry but I have
      go back to help Scarlet.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Damn, {playerName}! You took three people here?! That's kinda badass!
    alternativeText: Damn! You took three people here?! That's kinda badass!
    character: {fileID: 11400000, guid: f5a7c9d1e2b34567890123456789abcd, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I'll bring more soon, be ready.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: The other two have already started to subdue the confused guards.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: We got it. Be careful!
    alternativeText: 
    character: {fileID: 11400000, guid: bbccddeeff00112233445566778899aa, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I nod and shift back to the past where Scarlet is.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 16dfa76dbb94f464989ce1c99d3fd82e, type: 3}
  nextScene: {fileID: 11400000, guid: d0b2a2b3c4d5e6f708192a3b4c5d6e7b, type: 2}
