  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S10_7
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: We enter the house and head straight to the bookshelf that's taking up
      a whole wall.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: This house seems to have only one room with the bed and kitchen all tightly
      squeezed in, and of course a small bathroom.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Lu pulls out one of the many books in the shelf but only halfway.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Suddenly the shelf makes a lot of clicking noises and sinks into the wall.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Wait, it can't be!
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: The shelf slides sideways into the wall, revealing some stairs that lead
      into a basement.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Woah, a secret passage!
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Sick, right?
    alternativeText: 
    character: {fileID: 11400000, guid: f5a7c9d1e2b34567890123456789abcd, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I nod and follow them down the stairs.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: e8749dc4fcfa9474a8a3c72c7bdc659e, type: 3}
  nextScene: {fileID: 11400000, guid: ac0b0c0d0e0f101112131415161718ac, type: 2}
