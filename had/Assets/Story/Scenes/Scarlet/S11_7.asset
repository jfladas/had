  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S11_7
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: I take a few steps away from the room as its doors close and pace back and forth there, wondering what's going on inside.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I can't hear anything at all from here.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: A few minutes later, Scarlet storms out.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: When she reaches me she grabs my hand, dragging me along with her.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Scarlet? What's wrong?
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Shift us back. Right now.
    alternativeText: 
    character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
      spriteIndex: 1
      type: 1
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Did something happen?
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: When I look behind me, I see the prince following us from a distance with some guards behind him.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Yikes! I guess the plan failed completely.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: fe3df7bfda5b4784b8a3ad58532db4aa, type: 3}
  nextScene: {fileID: 11400000, guid: bc11a2b3c4d5e6f708192a3b4c5d6e7f, type: 2}

