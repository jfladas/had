      type: 0
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Okay then, I will just get right to it, I guess.
    alternativeText: 
    character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
