  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: I see that my cup has been filled with tea already. The servants probably
      did that.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Thank you, but I normally don't have breakfast. This tea is enough.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I see something like disappointment appear on Scarlet's face for a brief
      moment, but it fades away quickly.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
