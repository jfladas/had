  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S11_4
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: I land in the room, where Scarlet and Amelie nursed me back to health before.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 8300000, guid: ca644bccb10bda444bd0ff07812d3a81, type: 3}
    sound: {fileID: 0}
  - text: If I'm right, then she should appear right about now.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: With a poof, Scarlet appears in front of me.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
      spriteIndex: 9
      type: 1
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Nice, it worked! Looks like I have complete control over my shifting power
      now.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Long time no see, Scarlet.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Her eyes widen in shock.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
      spriteIndex: 13
      type: 0
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Huh?
    alternativeText: 
    character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: How long has it been? Like, two months?
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "What's the meaning of this?\u2026"
    alternativeText: 
    character: {fileID: 11400000, guid: 9c82936b944e581478f4d23ce326563a, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: c682d54ecf993f94e8171edb5751f2b1, type: 3}
  nextScene: {fileID: 11400000, guid: 5c11a2b3c4d5e6f708192a3b4c5d6e7f, type: 2}
