  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S8_2
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: It really feels like the earthquake didn't happen at all. At least while
      I'm here at work.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 8300000, guid: 4ddd349202a6f2d4ab954f83223dbcc0, type: 3}
    sound: {fileID: 0}
  - text: I'm impressed that Miss Moon managed to get everything back on its track
      so quickly, it shows how dedicated she is to her company.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: That reminds me, I haven't seen her at all today. She must be cooped up
      in her office right now, working as always.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 9ffb627455adace4786cef9541e6c996, type: 3}
  nextScene: {fileID: 11400000, guid: b2c3d4e5f60718293a4b5c6d7e8f901a, type: 2}
