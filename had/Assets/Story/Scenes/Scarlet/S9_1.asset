--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S9_1
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: I feel my whole body aching. I'm sweating even though I feel cold.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 8300000, guid: ca644bccb10bda444bd0ff07812d3a81, type: 3}
    sound: {fileID: 0}
  - text: What was that? I don't feel so good.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I hear some muffled voices and then the click of a door opening.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: On second thought, just leave it here. I'll take care of it myself.
    alternativeText: 
    character: {fileID: 11400000, guid: 0da3ca1f8a6962f4b9b7873516fd35e9, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "But you mustn't, my lady! It is my duty\u2014"
    alternativeText: 
    character: {fileID: 11400000, guid: e98f6dd1b5f6d3e4e87cd47b6a20f514, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: It's fine, Amelie.
    alternativeText: 
    character: {fileID: 11400000, guid: 0da3ca1f8a6962f4b9b7873516fd35e9, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: As you wish, my lady.
    alternativeText: 
    character: {fileID: 11400000, guid: 5f2a7b1c9d3e4f60718293a4b5c6d7e8, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Miss Moon? Who's Amelie? Am I having a weird dream again?
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Just when I am about to open my eyes, I feel something cold on my forehead.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Mm!
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: That startled me!
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 8ae56a62986e8624a8515e580a96d329, type: 3}
  nextScene: {fileID: 11400000, guid: b98e3456e2cee60479629064f6d93b0b, type: 2}
