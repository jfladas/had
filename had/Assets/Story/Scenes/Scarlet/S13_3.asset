  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: S13_3
  m_EditorClassIdentifier: Assembly-CSharp::StoryScene
  sentences:
  - text: With that, I step into the portal and let myself fall.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: The cloaked figures all follow.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Good. Looks like they really left them alone now.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Before the darkness completely engulfs me, I hear Scarlet yell out my name
      in despair.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I'll just have to fight to death if that's what it takes to get back to
      you.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: A faint whisper escapes my lips.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I will always find my way back to you. Even when I'm dead.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: db6143dffc3415a4cb9df1bede0e2ac3, type: 3}
  nextScene: {fileID: 11400000, guid: 7dc6e362b2e148c9831b58ca7a41d109, type: 2}
