  sentences:
  - text: Outside, Mr. Horse pauses briefly and mutters something to himself while
      looking down at his hands.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "How strange\u2026"
    alternativeText: 
    character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Huh?
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: He just shakes his head dismissively.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Let us go home.
    alternativeText: 
    character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
