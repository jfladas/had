  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: H12_X1_3a
  m_EditorClassIdentifier: 
  sentences:
  - text: I scratch my neck awkwardly.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: This room is pretty big, but I have felt a bit uncomfortable since I got
      here.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I think I might just need a breath of fresh air, if that's alright.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Of course, I can show you the way outside.
    alternativeText: 
    character: {fileID: 11400000, guid: 61fc1d7aa81b44fd96274f46c48e8dfa, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I keep rubbing my neck. There's a weird itch I can't seem to get rid of.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I will be with you in just a second; I need to use the restroom.
    alternativeText: 
    character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Okay, sounds good.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
      spriteIndex: 0
      type: 3
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: d1cdacf9c9530b74b9973cee8a95af55, type: 3}
  nextScene: {fileID: 11400000, guid: fac3e85b3dfca064fa54597471c462f2, type: 2}
