  sentences:
  - text: I think we've seen enough of this gym for today.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
      spriteIndex: 0
      type: 1
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Are you ready to head back to the apartment?
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I am.
    alternativeText: 
    character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: We leave the building, not without being silently stared down by everyone
      in the vicinity, of course.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
