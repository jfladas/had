  m_Name: H8_X1_2_2
  m_EditorClassIdentifier: 
  sentences:
  - text: '*A-CHOO!*'
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Finally, the pressure escapes in a loud sneeze. I feel as if I got propelled
      back from the force. Wind rushes past from behind me.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Some faint colourful shapes appear in my field of vision. I open my eyes,
      hoping to snap back into reality, but I continue to simply see all black. The
      flying shapes seem more saturated now, forming irregular patterns spinning
      in mid-air.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: What is happening? I feel like I'm floating in space or something. Where
      am I?
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Mr. Horse?
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 2ac81b3fa8c07cf4883385768872e799, type: 3}
  nextScene: {fileID: 11400000, guid: aeb3c6ecc8fd448e971755527dd453c8, type: 2}
