  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: H8_2
  m_EditorClassIdentifier: 
  sentences:
  - text: A sudden gust of wind blows past and carries a cloud of dust particles
      with it. I feel a slight tickle in my nose.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Let's get to somewhere a bit more sheltered, we can talk in safety.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Yes, let us.
    alternativeText: 
    character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Another sharper tickle in my nose makes me gasp for air.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Oh, sneeze incoming. I better cover my mouth.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I gasp for air a second time and close my eyes. Mr. Horse takes a step
      back and shields himself from the imminent germ explosion.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
      spriteIndex: 7
      type: 0
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I feel lightheaded.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
      spriteIndex: 0
      type: 3
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: f710f8d7b86d6b546984f1ceedaf7fbd, type: 3}
  nextScene: {fileID: 11400000, guid: 88284a62f4da4e68abab590083c1a909, type: 2}
