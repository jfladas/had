MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: H7_3
  m_EditorClassIdentifier: 
  sentences:
  - text: As we finally step out back onto the streets, the reality of what has happened
      sets back in. We can see entire apartment blocks destroyed by the earthquake,
      some alleys completely covered by rubble, many people feeling visibly distraught
      from these scenes.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I don't even know how to feel about all this. Of all the crazy things that
      have been happening lately, this is easily the most horrifying.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I need to go home.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: That's the only thought on my mind right now. Without knowing if the building
      has survived the catastrophe or not, I begin to walk in its direction.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Where are you headed to?
    alternativeText: 
    character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I barely hear Mr. Horse's voice over the noise in my head. I continue walking,
      without saying a word. It's as if my legs have a mind of their own.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 3db0785a05cdb804ead5133abfe270c1, type: 2}
      spriteIndex: 0
      type: 3
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: f710f8d7b86d6b546984f1ceedaf7fbd, type: 3}
  nextScene: {fileID: 11400000, guid: 0dcdc21312a440f7a22d58806be311ad, type: 2}
