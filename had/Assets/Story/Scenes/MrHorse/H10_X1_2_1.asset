%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: H10_X1_2_1
  m_EditorClassIdentifier: 
  sentences:
  - text: This is getting a bit creepy. I need to find a way out of here.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I turn away and distance myself from the unsettling voices.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "He has been\u2026"
    alternativeText: 
    character: {fileID: 11400000, guid: c86454fd71fe4258bbe97dd2023a6898, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: They quickly fade and I am once again surrounded by complete silence.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I'm really curious what else they have to say but this place just gives
      me the chills. And it doesn't seem like I am supposed to hear all this.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Again, I am walking through the empty space in search of any sort of exit.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I'm scared. I kinda wish Mr. Horse was here with me right now. Somehow,
      I've always felt a bit calmer with him by my side. I don't know why.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: My pace quickens.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: If I just go far enough, I will get somewhere, right?
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "I just have to\u2026"
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: My fear slowly turns into panic. Nothing changes. Everything is the same.
      White.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I start running and close my eyes.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Please\u2026"
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I feel a single tear running down my cheek. It feels freezing cold against
      my skin.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "It drops down to the floor and\u2026"
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: c017f2dc9f1c531439bd28453439c861, type: 3}
  nextScene: {fileID: 11400000, guid: 865b7212068540ccb4933bedb7bc71f6, type: 2}
