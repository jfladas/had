  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: H13_2
  m_EditorClassIdentifier: 
  sentences:
  - text: The next day, we get picked up from the palace by a private chauffeur.
      We drive for about 15 minutes mostly past green fields. When we reach our destination,
      I take a look around.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Something about this place rings a bell\u2026"
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: We approach the house and Mr. Horse knocks on the door. The entrance is
      right by a beautiful fountain at what seems to be a town plaza.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Now I know why it feels like I know this place!
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: The door opens and we get greeted by a familiar face.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Welcome!
    alternativeText: 
    character: {fileID: 11400000, guid: c1e07724d9394b31aa9919cbfbf8b526, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 41de7d8911b06044eb1ffbfc63d6d72a, type: 3}
  nextScene: {fileID: 11400000, guid: b1a8f9d536f3434c96628b6935675336, type: 2}
