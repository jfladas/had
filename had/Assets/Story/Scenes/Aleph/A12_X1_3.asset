%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: A12_X1_3
  m_EditorClassIdentifier: 
  sentences:
  - text: "You busy today? It\u2019s fine, I won\u2019t let myself slack off. You
      don\u2019t have to spend each day on supervising me."
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Are you sure? You can take it easy for once. I just really have to go record
      a song today, sorry about that.
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Oh, right. He has his duties as a singer.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Don\u2019t feel bad about this, it\u2019s your job after all. I can manage.
      I can\u2019t expect you to be there for me every single day."
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Aleph still has an apologetic expression on his face.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Then, I\u2019ll tell James to stay here. Tell him if you need anything.
      I\u2019ll be back in the evening."
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
      spriteIndex: 10
      type: 0
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Ugh, wipe that look off your face, you\u2019ve done so much for me already.
      I should try to make him feel better."
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "That\u2019s fine. Tomorrow we can try that thing we talked about, you
      know, finding the timeline where your parents are alive."
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Aleph\u2019s mood immediately brightens up and he comes over and hugs
      me."
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
      spriteIndex: 2
      type: 0
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Oh, thank you {playerName}. It means a lot.
    alternativeText: Oh, thank you! It means a lot.
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
      spriteIndex: 2
      type: 2
      position: {x: 0, y: -200}
      speed: -1
      targetScale: 1.5
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I squeeze my arms around him even tighter.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Anything for you. Now, go and slay that recording.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Aleph stands up straight and salutes.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
      spriteIndex: 0
      type: 2
      position: {x: 0, y: 0}
      speed: -1
      targetScale: 1
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Aye aye, captain!
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Well, that was easy. I\u2019m glad he\u2019s cheerful again."
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I wave goodbye and Aleph leaves.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "That day I train by myself and try to think of a way to achieve tomorrow\u2019s
      task. But I can\u2019t come up with a solution yet."
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 2ac81b3fa8c07cf4883385768872e799, type: 3}
  nextScene: {fileID: 11400000, guid: 211ee388d4e13b3458a497b99bbe7576, type: 2}
