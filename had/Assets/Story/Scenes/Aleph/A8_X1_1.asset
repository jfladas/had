%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: A8_X1_1
  m_EditorClassIdentifier: 
  sentences:
  - text: I feel like something is about to happen.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: This feeling. The air seems weird.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "While I\u2019m worried about this ominous feeling I have, Aleph comes
      over to me."
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
      spriteIndex: 0
      type: 1
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "I just talked to my manager. He says one of my homes is unharmed. We can
      go there if you can\u2019t stay in your apartment."
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Do you feel this too?
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "I couldn\u2019t help but ignore him, as this urging feeling grew by each
      second."
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "What do you mean? Are you okay? You don\u2019t look so good."
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Aleph, something is very wrong! Can you really not feel it? It\u2019s
      like the air is twisting."
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: In a state of panic, I begin to hyperventilate.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "No! No! No! I have to do something. It\u2019s about to happen any moment
      now."
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "{playerName}, what\u2019s happening? Are you in pain?"
    alternativeText: "What\u2019s happening? Are you in pain?"
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I crouch on the ground while holding my hands over my ears.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Aleph kneels down beside me while rubbing my back trying to soothe me.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
      spriteIndex: 0
      type: 2
      position: {x: 0, y: -200}
      speed: -1
      targetScale: 1.5
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "It\u2019s gonna be okay {playerName}. The earthquake is over. I think
      you\u2019re just a little shocked. Let\u2019s try to calm down."
    alternativeText: "It\u2019s gonna be okay. The earthquake is over. I think you\u2019re
      just a little shocked. Let\u2019s try to calm down."
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: f710f8d7b86d6b546984f1ceedaf7fbd, type: 3}
  nextScene: {fileID: 11400000, guid: 153e16ed38433de4398f451f1734ebbf, type: 2}
