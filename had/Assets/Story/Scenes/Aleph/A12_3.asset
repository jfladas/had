  m_Name: A12_3
  m_EditorClassIdentifier: 
  sentences:
  - text: I search for the two right coils while flicking my hand in different directions,
      which makes them move along my motions.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 8300000, guid: 4d0717af095410a4fa1bed777103ae6d, type: 3}
    sound: {fileID: 0}
  - text: There. I can see the golden swirl.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: It feels like my body is floating towards it slowly.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I still need to concentrate on the other moving dimensions though.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
