%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: A11_X1_1
  m_EditorClassIdentifier: 
  sentences:
  - text: It seems like I fall for pretty boys easily.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I sit up in the bed and stretch.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "I wonder where Aleph is. I\u2019m pretty sure I was in his arms when we
      shifted."
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I think about how he shielded me from John and sigh.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: My heart starts to beat a little faster.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "I must really be smitten when I\u2019m more excited about him practically
      hugging me instead of being worried about his well being."
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I press my palms to my burning cheeks.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "But cow can I not fall for him when he\u2019s so hot???"
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: The door quietly opens and Alephs head pops in.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Oh, you\u2019re up."
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
      spriteIndex: 0
      type: 1
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Ah, good morning!
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Does your face hurt?
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I realise that my hands are still covering my cheeks.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I quickly pull them away in embarrassment.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: No. I was just trying to wake myself up a bit. Ha ha.
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I scream internally at my awkward laugh.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Good. I was worried. You were asleep for two and a half days, you know?
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions:
    - character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
      spriteIndex: 1
      type: 0
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: e6d245d606423614b9b3f09975142dfd, type: 3}
  nextScene: {fileID: 11400000, guid: 6c5a745fdad54c742b6e6642732a4a3f, type: 2}
