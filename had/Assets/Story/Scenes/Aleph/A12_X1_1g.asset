      type: 3
      position: {x: 0, y: 0}
      speed: 0
      targetScale: 0
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: 'Before falling asleep I think to myself:'
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "I really want to help Aleph meet his parents again. I. feel like I can
      do anything for him, because\u2026 I am in love with him."
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
