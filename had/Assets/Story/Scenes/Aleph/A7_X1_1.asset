  m_Name: A7_X1_1
  m_EditorClassIdentifier: 
  sentences:
  - text: "I mean, to be honest I did feel a bit weird about that\u2026"
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Aleph sighs.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I know, sorry about that.
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "I would like you to elaborate on that\u2026 you know, the soul stuff.
      I think I can trust you if you can give me a reasonable explanation."
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Aleph looks surprised.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Really? I would love to. It\u2019s a long story though. Are you willing
      to hear me out?"
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I still feel a bit conflicted, but something about him makes me want to
      trust him.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Yes, let\u2019s hear it. "
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 0a531472eb715104e8acc946d055c0dd, type: 3}
  nextScene: {fileID: 11400000, guid: 130a9bdb4b1a940419c4b47773ebf521, type: 2}
