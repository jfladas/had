MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: A15_1
  m_EditorClassIdentifier: 
  sentences:
  - text: I manage to subdue all the weaker Spirits, including John, with my new
      power.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Now, the only one left is the Leader.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Damn you, Sustainer!
    alternativeText: 
    character: {fileID: 11400000, guid: 52af34180e7f71641aafe2ffb133637b, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: He forms a gigantic spear with his black magic but I easily parry it with
      my own magic.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: A big blast lunges him backwards, causing him to drop the orbs.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Once the orbs hit the ground they vanish and reveal the people that have
      been trapped inside them.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "There\u2019s Ethan! And my boss! And the weird horse person. And a girl
      with a very unique hairstyle wearing a green dress."
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Finally, use my magic and shoot a huge blast right at the last remaining
      evil Spirit.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: He instantly evaporates.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 8bc793dca2501cc4187624d4c81608bd, type: 3}
  nextScene: {fileID: 11400000, guid: 168b43cf5c4bfda41935bdcba0fa3884, type: 2}
