  m_Name: A12_X1_1b
  m_EditorClassIdentifier: 
  sentences:
  - text: He shows me to the seat and gives me his number, in case I would need anything.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: I thank him and he leaves to join Aleph backstage.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: The fans are all excited and so am I.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: A few minutes later the show begins.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: All the lights go out except for the spotlight on the stage.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: And there he is.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: bd83f3418797c224983f33a8a46fd3bd, type: 3}
  nextScene: {fileID: 11400000, guid: ba4dff3949146e24788897dc95c22fe7, type: 2}
