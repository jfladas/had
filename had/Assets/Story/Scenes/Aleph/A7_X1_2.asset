  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 51fb4c6070f247e48b4377b5728b8182, type: 3}
  m_Name: A7_X1_2
  m_EditorClassIdentifier: 
  sentences:
  - text: "No worries! I actually just forgot that you gave me your number, that\u2019s
      why."
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "It\u2019s true that it slipped my mind with all that\u2019s been going
      on."
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Really? I\u2019m glad that it wasn\u2019t my first impression that was
      the problem then."
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: He jokingly wipes the sweat off his brow.
    alternativeText: 
    character: {fileID: 11400000, guid: 221cb615d975cab419307e866ebd5c5c, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Would you mind if I explained myself a little though? I don\u2019t want
      you to stay confused about this."
    alternativeText: 
    character: {fileID: 11400000, guid: 8021ae93b2207b94a95f0fd830781878, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: Well if he can explain those remarks about my soul then I might feel more
      inclined to be his friend.
    alternativeText: 
    character: {fileID: 11400000, guid: 4849dc22c0fc77f45b58cdfcf9fc156e, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  - text: "Sure. I\u2019ve genuinely been curious about that."
    alternativeText: 
    character: {fileID: 11400000, guid: d69d53562766de143bf061768e3de597, type: 2}
    actions: []
    music: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: 0a531472eb715104e8acc946d055c0dd, type: 3}
  nextScene: {fileID: 11400000, guid: 130a9bdb4b1a940419c4b47773ebf521, type: 2}
